{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/python\" \"${CLAUDE_PLUGIN_ROOT}/hooks/auto_tidy.py\"",
            "timeout": 120,
            "statusMessage": "Tidying workflow positions...",
            "async": true
          }
        ]
      }
    ]
  }
}
